# Unusual Whales API (Bearer token UUID) — SERVER ONLY. Never put in NEXT_PUBLIC_*.
UNUSUAL_WHALES_API_KEY=your-api-key-here

# Optional overrides
UW_BASE_URL=https://api.unusualwhales.com
RUST_LOG=risk_watcher=debug,tower_http=info
BIND_ADDR=127.0.0.1:8080
# Cloud hosts often set PORT instead of BIND_ADDR (binds 0.0.0.0:$PORT).

# Vercel Services: do NOT set BACKEND_URL yourself — it is injected by the
# frontend→backend service binding in vercel.json.
#
# Local next+cargo (without `vercel dev`):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# Or leave NEXT_PUBLIC_API_URL unset and set BACKEND_URL for next.config rewrites.

