# Unusual Whales API (Bearer token UUID) — SERVER ONLY. Never put in NEXT_PUBLIC_*.
UNUSUAL_WHALES_API_KEY=your-api-key-here

# Optional overrides
UW_BASE_URL=https://api.unusualwhales.com
RUST_LOG=risk_watcher=debug,tower_http=info
BIND_ADDR=127.0.0.1:8080
# Cloud hosts often set PORT instead of BIND_ADDR (binds 0.0.0.0:$PORT).

# Frontend (Vercel): server-only rewrite target to the deployed Rust API.
# BACKEND_URL=https://risk-watcher-api.fly.dev
# Leave NEXT_PUBLIC_API_URL unset in production so the browser uses same-origin /api/v1.

